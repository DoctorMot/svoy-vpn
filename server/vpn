#!/bin/bash
# vpn — ключи для VLESS + REALITY на этом сервере (Xray). Часть проекта «Свой VPN».
# Выпускает отдельный ключ на каждое устройство, показывает ссылку и QR,
# собирает профиль для Clash Verge, отзывает ключи. Запуск: vpn help
set -uo pipefail
# Если SSH-сессия оборвётся (например, она сама шла через этот VPN и Xray
# перезапускается), команда всё равно доработает до конца: проверка и откат не пропадут.
trap '' HUP

VPN_VERSION=1.2.0   # версия «Свой VPN»; сверяется с файлом VERSION при сборке (tools/build.py)
CFG="${VPN_CONFIG:-/usr/local/etc/xray/config.json}"
OUT="${VPN_OUT:-/root/vpn-keys}"
BRIDGES="${VPN_BRIDGES:-/etc/svoy-vpn/bridges}"   # мосты через Россию: строки «IP ПОРТ»
GPORT=""; GSVC=""                                  # запасной вход gRPC (vpn grpc on) — заполняет load
mkdir -p "$OUT"; chmod 700 "$OUT"

red(){ printf '\033[31m%s\033[0m\n' "$*"; }
grn(){ printf '\033[32m%s\033[0m\n' "$*"; }
dim(){ printf '\033[2m%s\033[0m\n' "$*"; }
die(){ red "Ошибка: $*"; exit 1; }

[ -f "$CFG" ] || die "не найден $CFG — сервер ставили не скриптом из видео?"
command -v python3 >/dev/null || die "нет python3"
command -v xray >/dev/null || die "нет xray"

# --- параметры сервера из config.json ---
# Обычные входы — TCP (с Vision). Запасной вход gRPC (vpn grpc on) — отдельно: порт и serviceName.
params() {
python3 - "$CFG" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
v = [i for i in c.get("inbounds", []) if i.get("protocol") == "vless"]
if not v: sys.exit("в конфиге нет vless-подключений")
net = lambda i: i.get("streamSettings", {}).get("network") or "tcp"
t = [i for i in v if net(i) != "grpc"] or v
g = [i for i in v if net(i) == "grpc"]
r = t[0]["streamSettings"]["realitySettings"]
print(r["privateKey"]); print(r["serverNames"][0]); print(next((x for x in r["shortIds"] if x), ""))
print(" ".join(str(i["port"]) for i in t))
print(g[0]["port"] if g else "")
print(g[0]["streamSettings"].get("grpcSettings", {}).get("serviceName", "") if g else "")
PY
}

server_ip() {
  if [ -n "${VPN_IP:-}" ]; then echo "$VPN_IP"; return; fi
  [ -s "$OUT/server_ip" ] && { cat "$OUT/server_ip"; return; }
  local ip
  ip=$(hostname -I 2>/dev/null | tr ' ' '\n' | grep -Ev '^(10\.|127\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|169\.254\.|100\.(6[4-9]|[7-9][0-9]|1[01][0-9]|12[0-7])\.)' | grep -E '^[0-9.]+$' | head -1)
  [ -z "$ip" ] && ip=$(curl -4 -s --max-time 8 https://api.ipify.org || true)
  [ -n "$ip" ] || die "не удалось определить IP сервера. Задайте вручную: echo 1.2.3.4 > $OUT/server_ip"
  echo "$ip"
}

load() {
  mapfile -t P < <(params) || die "не удалось прочитать $CFG"
  PRIV="${P[0]}"; DEST="${P[1]}"; SID="${P[2]}"; PORTS="${P[3]}"; GPORT="${P[4]:-}"; GSVC="${P[5]:-}"
  PUB=$(xray x25519 -i "$PRIV" 2>/dev/null | awk -F': *' '/^(Password|PublicKey|Public key)/{print $2; exit}')
  [ -n "$PUB" ] || die "не удалось вычислить публичный ключ (xray x25519 -i)"
  IP=$(server_ip)
}

uuid_of() {
python3 - "$CFG" "$1" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
for i in c["inbounds"]:
    if i.get("protocol") != "vless": continue
    for u in i["settings"]["clients"]:
        if u.get("email") == sys.argv[2]: print(u["id"]); sys.exit(0)
sys.exit(1)
PY
}

check_name() {
  [[ "$1" =~ ^[a-zA-Z0-9_-]{1,32}$ ]] || die "имя «$1» не подходит: только латиница, цифры, - и _, до 32 символов. Пример: phone-anna"
}

link() {  # link UUID PORT NAME [АДРЕС ПОДПИСЬ] — по умолчанию адрес этого сервера
  echo "vless://$1@${4:-$IP}:$2?encryption=none&flow=xtls-rprx-vision&security=reality&sni=$DEST&fp=chrome&pbk=$PUB&sid=$SID&type=tcp&headerType=none#$3-${5:-$2}"
}

glink() {  # glink UUID NAME [АДРЕС ПОДПИСЬ] — ссылка на запасной вход gRPC (без Vision)
  echo "vless://$1@${3:-$IP}:$GPORT?encryption=none&security=reality&sni=$DEST&fp=chrome&pbk=$PUB&sid=$SID&type=grpc&serviceName=$GSVC&mode=gun#$2-${4:-grpc}"
}

bridges() {  # мосты: по строке «IP ПОРТ»
  [ -s "$BRIDGES" ] || return 0
  awk 'NF >= 2 && $1 ~ /^[0-9.]+$/ && $2 ~ /^[0-9]+$/ {print $1, $2}' "$BRIDGES"
}

apply() {  # проверить конфиг и перезапустить; при сбое откатить
  if ! xray run -test -config "$CFG" >/dev/null 2>&1; then
    cp "$BAK" "$CFG"; die "новый конфиг не прошёл проверку — вернул прежний, ничего не сломано"
  fi
  systemctl restart xray; sleep 2
  if ! systemctl is-active --quiet xray; then
    cp "$BAK" "$CFG"; systemctl restart xray
    die "Xray не запустился с новым конфигом — вернул прежний. Лог: journalctl -u xray -n 30"
  fi
}

backup() { BAK="$OUT/config-$(date +%Y%m%d-%H%M%S).json"; cp "$CFG" "$BAK"; }

show_qr() {  # show_qr TEXT NAME
  if ! command -v qrencode >/dev/null; then
    dim "ставлю qrencode для QR-кодов…"
    apt-get install -y qrencode >/dev/null 2>&1 || { apt-get update -qq >/dev/null 2>&1; apt-get install -y qrencode >/dev/null 2>&1; } || true
  fi
  if command -v qrencode >/dev/null; then
    qrencode -t ansiutf8 -m 2 "$1"
    qrencode -t PNG -s 8 -o "$OUT/$2.png" "$1" && dim "картинка с QR: $OUT/$2.png"
  else
    dim "(qrencode не установился — QR не показан, используйте ссылку)"
  fi
}

cmd_list() {
python3 - "$CFG" <<'PY'
import json, sys
c = json.load(open(sys.argv[1])); seen = {}
for i in c["inbounds"]:
    if i.get("protocol") != "vless": continue
    for u in i["settings"]["clients"]:
        seen.setdefault(u.get("email") or "(без имени)", u["id"])
print(f"Ключей: {len(seen)}")
for k, v in seen.items(): print(f"  {k:<24} {v[:8]}…")
PY
}

cmd_add() {
  local name="${1:-}"; [ -n "$name" ] || die "укажите имя: vpn add phone"
  check_name "$name"
  uuid_of "$name" >/dev/null 2>&1 && die "ключ «$name» уже есть. Показать его: vpn link $name"
  load; backup
  local id; id=$(xray uuid)
  python3 - "$CFG" "$id" "$name" <<'PY'
import json, sys
p, uid, name = sys.argv[1:4]
c = json.load(open(p))
for i in c["inbounds"]:
    if i.get("protocol") == "vless":
        grpc = i.get("streamSettings", {}).get("network") == "grpc"   # Vision работает только поверх TCP
        i["settings"]["clients"].append({"id": uid, "flow": "" if grpc else "xtls-rprx-vision", "email": name})
json.dump(c, open(p, "w"), indent=2)
PY
  apply
  grn "Готово: выпущен ключ «$name»."
  echo; cmd_link "$name"
}

cmd_link() {
  local name="${1:-}" want="${2:-}" want2="${3:-}"; [ -n "$name" ] || die "укажите имя: vpn link phone"
  local id; id=$(uuid_of "$name") || die "ключа «$name» нет. Список: vpn list"
  [ -n "${IP:-}" ] || load
  local first=1 p b bp bip=""
  for p in $PORTS; do
    [ $first = 1 ] && echo "Основная ссылка (порт $p):" || echo "Запасная ссылка (порт $p):"
    link "$id" "$p" "$name"; echo; first=0
  done
  while read -r b bp; do
    [ -n "$b" ] || continue
    echo "Через мост $b (порт $bp) — те же ключи, адрес моста:"
    link "$id" "$bp" "$name" "$b" "bridge-$b"; echo
    [ -n "$bip" ] || bip="$b"
  done < <(bridges)
  if [ -n "$GPORT" ]; then
    echo "Запасной транспорт gRPC (порт $GPORT) — если обычные ссылки перестали работать:"
    glink "$id" "$name"; echo
    while read -r b bp; do
      [ -n "$b" ] || continue
      echo "gRPC через мост $b (порт $GPORT):"
      glink "$id" "$name" "$b" "grpc-bridge-$b"; echo
    done < <(bridges)
  fi
  if [ "$want" = grpc ]; then   # vpn qr ИМЯ grpc [IP_МОСТА]
    [ -n "$GPORT" ] || die "запасной транспорт gRPC выключен. Включить: vpn grpc on"
    if [ -n "$want2" ]; then
      bridges | awk -v b="$want2" '$1 == b {f=1} END {exit !f}' || die "моста $want2 нет. Список: vpn bridge list"
      echo "QR ссылки gRPC через мост $want2 — отсканируй приложением на телефоне:"
      show_qr "$(glink "$id" "$name" "$want2" "grpc-bridge-$want2")" "$name-grpc-bridge-$want2"
    else
      echo "QR ссылки gRPC — отсканируй приложением на телефоне:"
      show_qr "$(glink "$id" "$name")" "$name-grpc"
    fi
    return 0
  fi
  if [ -n "$want" ] && [[ "$want" == *.* ]]; then   # vpn qr ИМЯ IP_МОСТА
    bp=$(bridges | awk -v b="$want" '$1 == b {print $2; exit}')
    [ -n "$bp" ] || die "моста $want нет. Список: vpn bridge list"
    echo "QR ссылки через мост $want — отсканируй приложением на телефоне:"
    show_qr "$(link "$id" "$bp" "$name" "$want" "bridge-$want")" "$name-bridge-$want"
    return 0
  fi
  set -- $PORTS
  local qp="$1"
  if [ -n "$want" ]; then
    [[ " $PORTS " == *" $want "* ]] || die "порта $want нет. Есть: $PORTS"
    qp="$want"
  fi
  if [ "$qp" = "$1" ]; then
    echo "QR основной ссылки (порт $qp) — отсканируй приложением на телефоне:"
  else
    echo "QR запасной ссылки (порт $qp) — отсканируй приложением на телефоне:"
  fi
  show_qr "$(link "$id" "$qp" "$name")" "$name-$qp"
  [ -z "$want" ] && [ $# -gt 1 ] && dim "QR запасной ссылки: vpn qr $name $2"
  [ -z "$want" ] && [ -n "$bip" ] && dim "QR ссылки через мост: vpn qr $name $bip"
  [ -z "$want" ] && [ -n "$GPORT" ] && dim "QR ссылки gRPC: vpn qr $name grpc${bip:+   (через мост: vpn qr $name grpc $bip)}"
  return 0
}

cmd_yaml() {
  local name="${1:-}" mode="${2:-}"; [ -n "$name" ] || die "укажите имя: vpn yaml laptop"
  local id; id=$(uuid_of "$name") || die "ключа «$name» нет. Сначала: vpn add $name"
  load
  local f="$OUT/$name.yaml" proxies="" names="" p b bp bnames="" bdirect="" gproxies="" gnames=""
  node() {  # node ИМЯ АДРЕС ПОРТ
    proxies+="  - name: $1
    type: vless
    server: $2
    port: $3
    uuid: \"$id\"
    network: tcp
    tls: true
    udp: true
    flow: xtls-rprx-vision
    servername: $DEST
    client-fingerprint: chrome
    reality-opts:
      public-key: \"$PUB\"
      short-id: \"$SID\"

"
  }
  gnode() {  # gnode ИМЯ АДРЕС — запасной вход gRPC: те же ключи, другой «почерк» трафика, без Vision
    gproxies+="  - name: $1
    type: vless
    server: $2
    port: $GPORT
    uuid: \"$id\"
    network: grpc
    tls: true
    udp: true
    servername: $DEST
    client-fingerprint: chrome
    reality-opts:
      public-key: \"$PUB\"
      short-id: \"$SID\"
    grpc-opts:
      grpc-service-name: \"$GSVC\"

"
    gnames+="$1, "
  }
  for p in $PORTS; do
    node "VLESS-$p" "$IP" "$p"
    names+="VLESS-$p, "
  done
  [ -n "$GPORT" ] && gnode "GRPC-$GPORT" "$IP"
  # узлы через мост: те же ключи, адрес моста — мост пересылает шифрованные байты, не читая их
  while read -r b bp; do
    [ -n "$b" ] || continue
    node "BRIDGE-$b-$bp" "$b" "$bp"
    bnames+="BRIDGE-$b-$bp, "
    [ -n "$GPORT" ] && gnode "BRIDGE-GRPC-$b-$GPORT" "$b"
    bdirect+="  - IP-CIDR,$b/32,DIRECT,no-resolve
"
  done < <(bridges)
  names="${names%, }"
  local auto="  - name: AUTO
    type: url-test
    proxies: [$names]
    url: https://cp.cloudflare.com/generate_204
    interval: 300
    tolerance: 50"
  if [ -n "$gnames" ]; then
    # gRPC включают, когда обычный протокол распознают, — тогда он первый
    proxies="$gproxies$proxies"
    names="${gnames%, }, $names${bnames:+, ${bnames%, }}"
    auto="  # Первым — запасной транспорт gRPC (включён командой vpn grpc on): напрямую, потом через мост.
  # Если он не отвечает — обычный узел напрямую, потом через мост. Группа переключается сама.
  - name: AUTO
    type: fallback
    proxies: [$names]
    url: https://cp.cloudflare.com/generate_204
    interval: 60"
  elif [ -n "$bnames" ]; then
    names="$names, ${bnames%, }"
    # прямой узел основной; мост подхватывает сам, если прямой перестал отвечать
    auto="  # Основной — прямой узел. Если он перестал отвечать (провайдер режет адрес сервера),
  # группа сама переходит на мост и возвращается, когда прямой снова заработает.
  - name: AUTO
    type: fallback
    proxies: [$names]
    url: https://cp.cloudflare.com/generate_204
    interval: 60"
  fi
  local ru=""
  if [ "$mode" != "--all" ]; then
    ru="  # Российские сайты — напрямую, мимо США (госуслуги, банки, маркетплейсы)
  - DOMAIN-SUFFIX,ru,DIRECT
  - DOMAIN-SUFFIX,su,DIRECT
  - DOMAIN-SUFFIX,xn--p1ai,DIRECT
  - DOMAIN-SUFFIX,xn--p1acf,DIRECT
  - DOMAIN-SUFFIX,xn--80adxhks,DIRECT
  - DOMAIN-SUFFIX,yandex.net,DIRECT
  - DOMAIN-SUFFIX,yandex.com,DIRECT
  - DOMAIN-SUFFIX,yastatic.net,DIRECT
  - DOMAIN-SUFFIX,vk.com,DIRECT
  - DOMAIN-SUFFIX,vk.me,DIRECT
  - DOMAIN-SUFFIX,userapi.com,DIRECT
  - DOMAIN-SUFFIX,vkuser.net,DIRECT
  - DOMAIN-SUFFIX,mycdn.me,DIRECT
  - DOMAIN-SUFFIX,avito.st,DIRECT
"
  fi
  cat > "$f" <<EOF
# Профиль Clash Verge — ключ «$name», сервер $IP
# Создан $(date +%Y-%m-%d) командой: vpn yaml $name $mode
mode: rule
log-level: info
ipv6: false
unified-delay: true
tcp-concurrent: true

profile:
  store-selected: true
  store-fake-ip: true

dns:
  enable: true
  listen: 127.0.0.1:1053
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  fake-ip-filter:
    - '*.lan'
    - '*.local'
  default-nameserver: [1.1.1.1, 8.8.8.8]
  nameserver:
    - https://1.1.1.1/dns-query
    - https://8.8.8.8/dns-query
  proxy-server-nameserver:
    - https://1.1.1.1/dns-query

proxies:
$proxies
proxy-groups:
  - name: PROXY
    type: select
    proxies: [AUTO, $names, DIRECT]
$auto
  # Режим «Глобальный»: всё через сервер. Без этой группы mihomo выбирает
  # в нём DIRECT, и в «Глобальном» трафик идёт мимо VPN.
  - name: GLOBAL
    type: select
    proxies: [PROXY, AUTO, $names, DIRECT]

rules:
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - DOMAIN-SUFFIX,lan,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - IP-CIDR,$IP/32,DIRECT,no-resolve
$bdirect$ru  - MATCH,PROXY
EOF
  chmod 600 "$f"
  grn "Профиль готов: $f"
  if [ -n "$gnames" ]; then dim "Запасной транспорт gRPC включён: ${gnames%, } — первые в группе AUTO."
  elif [ -n "$bnames" ]; then dim "Узлы через мост: ${bnames%, }. Основной — прямой, мост включается сам, если прямой не отвечает."; fi
  if [ "$mode" = "--all" ]; then dim "Режим: весь трафик через США."; else dim "Режим: российские сайты напрямую, остальное через США. Всё через США: vpn yaml $name --all"; fi
  echo
  echo "Скачать на компьютер — эту команду вводи в НОВОМ окне PowerShell на компьютере, не здесь:"
  echo "  scp root@$IP:$f \"\$env:USERPROFILE\\Downloads\\$name.yaml\""
  echo "Файл окажется в папке «Загрузки»."
}

cmd_del() {
  local name="${1:-}"; [ -n "$name" ] || die "укажите имя: vpn del phone"
  uuid_of "$name" >/dev/null 2>&1 || die "ключа «$name» нет. Список: vpn list"
  local left
  left=$(python3 - "$CFG" "$name" <<'PY'
import json, sys
c = json.load(open(sys.argv[1])); s = set()
for i in c["inbounds"]:
    if i.get("protocol") == "vless":
        s.update(u.get("email") for u in i["settings"]["clients"] if u.get("email") != sys.argv[2])
print(len(s))
PY
)
  [ "$left" -ge 1 ] || die "это последний ключ — без него к серверу не подключится никто. Сначала выпустите другой: vpn add ИМЯ"
  backup
  python3 - "$CFG" "$name" <<'PY'
import json, sys
p, name = sys.argv[1:3]
c = json.load(open(p))
for i in c["inbounds"]:
    if i.get("protocol") == "vless":
        i["settings"]["clients"] = [u for u in i["settings"]["clients"] if u.get("email") != name]
json.dump(c, open(p, "w"), indent=2)
PY
  apply
  rm -f "$OUT/$name.png" "$OUT/$name.yaml"
  for p in $(params | sed -n 4p); do rm -f "$OUT/$name-$p.png"; done
  rm -f "$OUT/$name-bridge-"*.png "$OUT/$name-grpc"*.png
  grn "Ключ «$name» отозван. Устройство с ним больше не подключится."
}

stale_check() {  # Xray запущен раньше, чем менялся конфиг? значит работает со старыми ключами
  local pid et start mt
  pid=$(systemctl show -p MainPID --value xray 2>/dev/null)
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || pid=$(pgrep -o -x xray 2>/dev/null)
  [ -n "$pid" ] || return 0
  et=$(ps -o etimes= -p "$pid" 2>/dev/null | tr -d ' ')
  [[ "$et" =~ ^[0-9]+$ ]] || return 0
  start=$(( $(date +%s) - et )); mt=$(stat -c %Y "$CFG")
  if [ "$mt" -gt $((start + 2)) ]; then
    red "  Xray работает со СТАРЫМИ настройками: ключи менялись после его запуска."
    red "  Новые ключи не заработают, пока не выполнишь: systemctl restart xray"
  fi
}

cmd_log() {
  local name="${1:-}"; [ -n "$name" ] || die "укажите имя: vpn log phone"
  uuid_of "$name" >/dev/null 2>&1 || die "ключа «$name» нет. Список: vpn list"
  local f n
  f=$(python3 - "$CFG" <<'PY'
import json, sys
print(json.load(open(sys.argv[1])).get("log", {}).get("access", ""))
PY
)
  { [ -n "$f" ] && [ -f "$f" ]; } || die "журнал подключений не найден (${f:-не задан в конфиге})"
  # Xray пишет журнал в МЕСТНОМ времени сервера (у американских серверов это не UTC)
  echo "Сейчас на сервере: $(date '+%Y-%m-%d %H:%M:%S %Z') — в журнале время в этом же поясе"
  n=$(grep -cE "email: ${name}[[:space:]]*\$" "$f")
  if [ "$n" -eq 0 ]; then
    red "Подключений с ключом «$name» в журнале нет."
    echo "Устройство либо не достучалось до сервера, либо ключ не подошёл."
  else
    grn "Подключений с ключом «$name»: $n. Последние:"
    grep -E "email: ${name}[[:space:]]*\$" "$f" | tail -n 8
    local last ts ago
    last=$(grep -E "email: ${name}[[:space:]]*\$" "$f" | tail -n 1 | cut -c1-19 | tr / -)
    if ts=$(date -d "$last" +%s 2>/dev/null); then
      ago=$(( ($(date +%s) - ts) / 60 ))
      if [ "$ago" -le 5 ]; then grn "Последнее подключение — только что ($ago мин назад)."
      else echo "Последнее подключение — $ago мин назад. Свежих попыток не было."; fi
    fi
  fi
}

# --- сайт-прикрытие (dest / SNI) ---
# Заблокированные или замедляемые в России: Speedtest заблокирован РКН 30.07.2025,
# Cloudflare в России замедляют. Apple/iCloud сам Xray не советует: по ним IP блокируют чаще.
# Имя сайта-прикрытия провайдер видит в открытом виде.
BAD_DEST_RE='(^|\.)(speedtest\.net|ooklaserver\.net|cloudflare\.com|one\.one\.one\.one|apple\.com|icloud\.com)$'
DEST_CANDIDATES="${VPN_DEST_CANDIDATES:-www.bing.com dl.google.com www.microsoft.com www.samsung.com www.asus.com www.amd.com www.dell.com www.nvidia.com www.logitech.com www.hp.com}"

bad_dest() { [[ "$1" =~ $BAD_DEST_RE ]]; }

probe_dest() {  # те же требования, что в скрипте из видео: TLS 1.3 + HTTP/2 + ECDSA
  local d="$1" alg alpn
  alg=$(timeout 12 openssl s_client -connect "$d:443" -servername "$d" -tls1_3 </dev/null 2>/dev/null \
        | openssl x509 -noout -text 2>/dev/null | grep -m1 "Public Key Algorithm" | sed 's/.*: //')
  alpn=$(timeout 12 openssl s_client -connect "$d:443" -servername "$d" -alpn h2 -tls1_3 </dev/null 2>/dev/null \
        | grep -c "ALPN protocol: h2")
  if [ -z "$alg" ]; then echo "нет TLS 1.3 или сайт недоступен"; return 1; fi
  if [ "$alg" != "id-ecPublicKey" ]; then echo "сертификат не ECDSA ($alg)"; return 1; fi
  if [ "$alpn" != "1" ]; then echo "нет HTTP/2"; return 1; fi
  echo "подходит"; return 0
}

set_dest() {
  local d="$1"
  backup
  python3 - "$CFG" "$d" <<'PY'
import json, sys
p, d = sys.argv[1:3]
c = json.load(open(p))
for i in c["inbounds"]:
    if i.get("protocol") != "vless": continue
    r = i["streamSettings"]["realitySettings"]
    if "target" in r: r["target"] = f"{d}:443"
    else: r["dest"] = f"{d}:443"
    r["serverNames"] = [d]
json.dump(c, open(p, "w"), indent=2)
PY
  apply
  grn "Готово: сайт-прикрытие теперь $d."
  echo
  red "ВАЖНО: старые ссылки и профили больше не подключатся — в них прежнее имя сайта."
  echo "Обнови все устройства (сами ключи те же, меняется только ссылка):"
  python3 - "$CFG" <<'PY'
import json, sys
c = json.load(open(sys.argv[1])); seen = []
for i in c["inbounds"]:
    if i.get("protocol") != "vless": continue
    for u in i["settings"]["clients"]:
        e = u.get("email")
        if e and e not in seen: seen.append(e)
for e in seen:
    print(f"  {e:<16} телефон/планшет: vpn link {e}   ·   компьютер: vpn yaml {e}")
PY
}

cmd_dest() {
  local arg="${1:-}" d r
  load
  if [ -z "$arg" ]; then
    echo "Сейчас сайт-прикрытие: $DEST"
    bad_dest "$DEST" && red "  Этот сайт заблокирован или замедляется в России — из-за него VPN может не подключаться."
    echo "Проверяю кандидатов с сервера (до минуты)…"
    for d in $DEST_CANDIDATES; do
      r=$(probe_dest "$d") && grn "  $d — $r" || dim "  $d — $r"
    done
    echo "Сменить на первый подходящий: vpn dest auto     или на конкретный: vpn dest ИМЯ_САЙТА"
    return 0
  fi
  if [ "$arg" = "auto" ]; then
    echo "Ищу подходящий сайт-прикрытие…"
    for d in $DEST_CANDIDATES; do
      bad_dest "$d" && continue
      [ "$d" = "$DEST" ] && continue
      if r=$(probe_dest "$d"); then set_dest "$d"; return 0; fi
      dim "  $d — $r"
    done
    die "ни один кандидат не подошёл. Укажи сайт вручную: vpn dest ИМЯ_САЙТА"
  fi
  d="${arg,,}"
  [[ "$d" =~ ^[a-z0-9.-]+\.[a-z]{2,}$ ]] || die "«$arg» не похоже на имя сайта. Пример: vpn dest www.bing.com"
  bad_dest "$d" && die "$d заблокирован или замедляется в России — выбери другой"
  r=$(probe_dest "$d") || die "$d не подходит: $r"
  set_dest "$d"
}

# --- DNS на стороне сервера ---
# Телефонные приложения (Happ, v2rayNG) шлют DNS-запросы через туннель как UDP на 1.1.1.1:53.
# «vpn dns on» заставляет Xray отвечать на них самому: через DNS самого сервера,
# а если он не ответит — через DNS-over-HTTPS (TCP). Внешний UDP больше не нужен.
cmd_dns() {
  local mode="${1:-status}"
  case "$mode" in
    status|"")
      python3 - "$CFG" <<'PY'
import json, sys
c = json.load(open(sys.argv[1]))
on = any(o.get("tag") == "dns-out" for o in c.get("outbounds", []))
print("DNS на сервере: " + ("ВКЛЮЧЁН (vpn dns off — выключить)" if on else "выключен (vpn dns on — включить)"))
PY
      echo "Проверка: может ли сервер сам спросить DNS по UDP у 1.1.1.1…"
      if python3 - <<'PY'
import socket, sys
q = bytes.fromhex("123401000001000000000000") + b"\x06google\x03com\x00\x00\x01\x00\x01"
s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM); s.settimeout(5)
try:
    s.sendto(q, ("1.1.1.1", 53)); s.recv(512); sys.exit(0)
except Exception:
    sys.exit(1)
PY
      then grn "  ответ получен — UDP DNS с сервера работает"
      else red "  ответа НЕТ — сервер не получает DNS-ответы по UDP. Включи: vpn dns on"; fi
      ;;
    on|off)
      backup
      python3 - "$CFG" "$mode" <<'PY'
import json, sys
p, mode = sys.argv[1:3]
c = json.load(open(p))
outs = c.setdefault("outbounds", [])
rules = c.setdefault("routing", {}).setdefault("rules", [])
outs[:] = [o for o in outs if o.get("tag") != "dns-out"]
rules[:] = [r for r in rules if r.get("outboundTag") != "dns-out"]
c.pop("dns", None)
if mode == "on":
    c["dns"] = {"servers": ["localhost", "https+local://1.1.1.1/dns-query"], "queryStrategy": "UseIPv4"}
    outs.append({"protocol": "dns", "tag": "dns-out"})
    rules.insert(0, {"type": "field", "port": "53", "outboundTag": "dns-out"})
json.dump(c, open(p, "w"), indent=2)
PY
      apply
      if [ "$mode" = on ]; then grn "Готово: сервер сам отвечает на DNS-запросы устройств. Ссылки и ключи менять не нужно."
      else grn "Готово: DNS снова уходит напрямую, как было."; fi
      ;;
    *) die "используй: vpn dns, vpn dns on или vpn dns off" ;;
  esac
}

# --- мосты через российский сервер ---
# Мост (bridge.sh) только пересылает TCP на этот сервер: ключей у него нет. Здесь хранится
# список мостов, чтобы vpn yaml и vpn link выдавали узлы «через мост» с теми же ключами.
client_test() {  # client_test АДРЕС ПОРТ [grpc] — запрос в интернет через АДРЕС:ПОРТ с ключом этого сервера
  local ip="$1" port="$2" net="${3:-tcp}" st pid code="" try
  load
  st=$(mktemp /tmp/vpn-clienttest-XXXXXX.json)
  python3 - "$CFG" "$ip" "$port" "$PUB" "$net" "$GSVC" > "$st" <<'PY'
import json, sys
cfg, ip, port, pub, net, svc = sys.argv[1:7]
c = json.load(open(cfg))
i = [x for x in c["inbounds"] if x.get("protocol") == "vless"][0]
u = i["settings"]["clients"][0]
r = i["streamSettings"]["realitySettings"]
ss = {"network": net, "security": "reality", "realitySettings": {
      "serverName": r["serverNames"][0], "fingerprint": "chrome", "publicKey": pub,
      "shortId": next((s for s in r["shortIds"] if s), "")}}
if net == "grpc": ss["grpcSettings"] = {"serviceName": svc}
print(json.dumps({
  "log": {"loglevel": "warning"},
  "inbounds": [{"listen": "127.0.0.1", "port": 10898, "protocol": "socks", "settings": {"udp": True}}],
  "outbounds": [{"protocol": "vless", "settings": {"vnext": [{"address": ip, "port": int(port),
      "users": [{"id": u["id"], "encryption": "none", "flow": "" if net == "grpc" else "xtls-rprx-vision"}]}]},
    "streamSettings": ss}]}))
PY
  xray run -config "$st" >/dev/null 2>&1 &
  pid=$!
  sleep 2
  for try in 1 2 3; do   # первое соединение после перезапуска Xray бывает медленным
    code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 15 --noproxy '' --socks5-hostname 127.0.0.1:10898 \
           "${SELFTEST_URL:-https://www.gstatic.com/generate_204}" || true)
    case "$code" in 2*|3*) break ;; esac
    sleep 2
  done
  kill "$pid" 2>/dev/null; wait "$pid" 2>/dev/null
  rm -f "$st"
  case "$code" in 2*|3*) return 0 ;; *) return 1 ;; esac
}

cmd_bridge() {
  local act="${1:-list}" arg="${2:-}" opt="${3:-}" ip port b bp n=0
  case "$act" in
    list|ls|"")
      if [ "$arg" = "--plain" ]; then bridges; return 0; fi   # «IP ПОРТ» — для setup.sh
      while read -r b bp; do
        [ -n "$b" ] || continue
        n=$((n + 1))
        if timeout 5 bash -c "exec 3<>/dev/tcp/$b/$bp" 2>/dev/null; then echo "  $b порт $bp — отвечает"
        else red "  $b порт $bp — НЕ отвечает"; fi
      done < <(bridges)
      if [ "$n" = 0 ]; then
        echo "Мостов нет. Добавить: vpn bridge add IP_МОСТА (сначала настрой мост установщиком в режиме «мост»)"
      else
        dim "Сквозная проверка: vpn bridge test IP_МОСТА"
      fi
      ;;
    add)
      [ -n "$arg" ] || die "укажите IP моста: vpn bridge add 203.0.113.20   (или IP:порт, если порт моста не 443)"
      ip="${arg%%:*}"; port=443; [[ "$arg" == *:* ]] && port="${arg#*:}"
      [[ "$ip" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || die "«$ip» не похоже на IPv4-адрес моста"
      [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "«$port» — не порт"
      case "$ip" in 0.*|127.*|10.*|192.168.*|169.254.*) die "$ip — внутренний адрес, нужен внешний IP моста" ;; esac
      load
      [ "$ip" != "$IP" ] || die "$ip — это адрес самого сервера, а нужен адрес моста"
      mkdir -p "$(dirname "$BRIDGES")"
      if bridges | grep -Fqx "$ip $port"; then
        echo "Мост $ip (порт $port) уже в списке."
      else
        { bridges | awk -v b="$ip" '$1 != b'; echo "$ip $port"; } > "$BRIDGES.new"
        { echo "# Мосты «Свой VPN»: IP ПОРТ. Меняется командами vpn bridge add / del."; cat "$BRIDGES.new"; } > "$BRIDGES"
        rm -f "$BRIDGES.new"
        grn "Мост $ip (порт $port) добавлен."
      fi
      if [ "$opt" != "--no-test" ]; then
        echo "Проверяю связь через мост…"
        if client_test "$ip" "$port"; then grn "  запрос через мост прошёл"
        else red "  через мост запрос НЕ прошёл. Мост настроен на этот сервер? Проверка: vpn bridge test $ip"; fi
      fi
      echo "Узлы через мост появятся в новых профилях и ссылках: vpn yaml ИМЯ, vpn link ИМЯ."
      ;;
    del|rm|delete)
      [ -n "$arg" ] || die "укажите IP моста: vpn bridge del 203.0.113.20"
      bridges | awk -v b="$arg" '$1 == b {f=1} END {exit !f}' || die "моста $arg нет. Список: vpn bridge list"
      { echo "# Мосты «Свой VPN»: IP ПОРТ. Меняется командами vpn bridge add / del."; bridges | awk -v b="$arg" '$1 != b'; } > "$BRIDGES.new"
      mv "$BRIDGES.new" "$BRIDGES"
      grn "Мост $arg убран из списка."
      echo "Сделай профили заново (vpn yaml ИМЯ), иначе в них останется узел через этот мост."
      ;;
    test)
      [ -n "$arg" ] || die "укажите IP моста: vpn bridge test 203.0.113.20"
      bp=$(bridges | awk -v b="$arg" '$1 == b {print $2; exit}')
      [ -n "$bp" ] || bp=443
      echo "Проверяю: этот сервер → мост $arg:$bp → этот сервер → интернет (с ключом этого сервера)…"
      if client_test "$arg" "$bp"; then
        grn "Через мост $arg всё работает."
        if [ -n "$GPORT" ]; then
          if client_test "$arg" "$GPORT" grpc; then grn "gRPC через мост $arg тоже работает."
          else red "gRPC через мост $arg НЕ проходит: мост не пересылает порт $GPORT. Запусти установщик в режиме «мост» ещё раз."; fi
        fi
        return 0
      fi
      red "Через мост $arg запрос НЕ прошёл."
      if timeout 5 bash -c "exec 3<>/dev/tcp/$arg/$bp" 2>/dev/null; then
        echo "Порт $bp моста открыт, но до этого сервера не доходит: мост настроен на другой адрес?"
        echo "Перезапусти установщик в режиме «мост» с IP этого сервера."
      else
        echo "Порт $bp моста не отвечает: мост выключен, не настроен или его отключил хостер."
      fi
      return 1
      ;;
    *) die "используй: vpn bridge list | add IP | del IP | test IP" ;;
  esac
}

# --- запасной транспорт gRPC ---
# Те же ключи и маскировка, но поток упакован в gRPC (HTTP/2) — другой «почерк» трафика.
# Включают, только если провайдер начал распознавать обычный протокол (VLESS + TCP + REALITY).
# По умолчанию выключен; повторный запуск установщика его сохраняет.
ufw_port() {  # ufw_port allow|delete ПОРТ — если firewall включён
  command -v ufw >/dev/null 2>&1 || return 0
  ufw status 2>/dev/null | grep -q '^Status: active' || return 0
  if [ "$1" = allow ]; then ufw allow "$2"/tcp >/dev/null; else ufw delete allow "$2"/tcp >/dev/null 2>&1 || true; fi
}

grpc_tests() {  # проверка gRPC напрямую и через все мосты
  local b bp
  if client_test 127.0.0.1 "$GPORT" grpc; then grn "  запрос через gRPC прошёл"
  else red "  запрос через gRPC НЕ прошёл — журнал: journalctl -u xray -n 30"; fi
  while read -r b bp; do
    [ -n "$b" ] || continue
    if client_test "$b" "$GPORT" grpc; then grn "  gRPC через мост $b прошёл"
    else red "  gRPC через мост $b НЕ прошёл: мост не пересылает порт $GPORT. Запусти установщик в режиме «мост» ещё раз."; fi
  done < <(bridges)
}

cmd_grpc() {
  local act="${1:-status}" arg="${2:-}" port
  load
  case "$act" in
    status|"")
      if [ -z "$GPORT" ]; then
        echo "Запасной транспорт gRPC: выключен."
        dim "Включать, только если обычный VPN перестал работать и напрямую, и через мост: vpn grpc on"
      else
        echo "Запасной транспорт gRPC: включён, порт $GPORT."
        grpc_tests
      fi
      ;;
    on)
      if [ -n "$GPORT" ]; then
        ufw_port allow "$GPORT"
        echo "Запасной транспорт gRPC уже включён (порт $GPORT). Проверяю…"; grpc_tests; return 0
      fi
      port="${arg:-8443}"
      [[ "$port" =~ ^[0-9]{1,5}$ ]] && [ "$port" -ge 1 ] && [ "$port" -le 65535 ] || die "«$port» — не порт"
      [[ " $PORTS " != *" $port "* ]] || die "порт $port занят обычным входом VPN. Укажи другой: vpn grpc on 2053 (через мост пойдёт, только если мост пересылает этот порт)"
      if command -v ss >/dev/null && ss -tln 2>/dev/null | awk '{print $4}' | grep -qE "[:.]$port\$"; then
        die "порт $port уже занят другой программой. Укажи другой: vpn grpc on 2053"
      fi
      backup
      python3 - "$CFG" "$port" <<'PY'
import json, secrets, sys
p, port = sys.argv[1], int(sys.argv[2])
c = json.load(open(p))
v = [i for i in c["inbounds"] if i.get("protocol") == "vless"]
t = [i for i in v if (i.get("streamSettings", {}).get("network") or "tcp") != "grpc"]
src = (t or v)[0]
clients, seen = [], set()
for i in v:
    for u in i["settings"]["clients"]:
        k = u.get("email") or u["id"]
        if k in seen: continue
        seen.add(k)
        clients.append({"id": u["id"], "flow": "", "email": u.get("email") or u["id"][:8]})   # Vision — только поверх TCP
r = dict(src["streamSettings"]["realitySettings"])
c["inbounds"].append({
    "tag": f"vless-grpc-{port}", "listen": "0.0.0.0", "port": port, "protocol": "vless",
    "settings": {"clients": clients, "decryption": "none"},
    "streamSettings": {"network": "grpc", "security": "reality", "realitySettings": r,
                       "grpcSettings": {"serviceName": secrets.token_hex(6)}},
    "sniffing": src.get("sniffing", {"enabled": True, "destOverride": ["http", "tls", "quic"], "routeOnly": True}),
})
json.dump(c, open(p, "w"), indent=2)
PY
      apply
      load
      ufw_port allow "$GPORT"
      grn "Готово: запасной транспорт gRPC включён на порту $GPORT."
      echo "Проверяю…"; grpc_tests
      echo
      echo "Дальше:"
      echo "  компьютер — запусти установщик ещё раз (есть мост — режим 2): новый профиль ляжет на рабочий стол;"
      echo "  телефоны  — vpn yaml ИМЯ (FlClash) или vpn link ИМЯ (ссылка gRPC для Happ / v2rayNG)."
      dim "В новом профиле gRPC идёт первым, обычный протокол — запасным. Выключить: vpn grpc off"
      ;;
    off)
      [ -n "$GPORT" ] || { echo "Запасной транспорт gRPC и так выключен."; return 0; }
      backup
      python3 - "$CFG" <<'PY'
import json, sys
p = sys.argv[1]
c = json.load(open(p))
c["inbounds"] = [i for i in c["inbounds"] if i.get("streamSettings", {}).get("network") != "grpc"]
json.dump(c, open(p, "w"), indent=2)
PY
      apply
      ufw_port delete "$GPORT"
      grn "Готово: запасной транспорт gRPC выключен (порт $GPORT закрыт)."
      echo "Сделай профили заново: компьютер — установщик, телефоны — vpn yaml ИМЯ / vpn link ИМЯ."
      ;;
    test)
      [ -n "$GPORT" ] || die "запасной транспорт gRPC выключен. Включить: vpn grpc on"
      if [ -n "$arg" ]; then client_test "$arg" "$GPORT" grpc; return $?; fi   # для setup.sh: только код возврата
      client_test 127.0.0.1 "$GPORT" grpc; return $?
      ;;
    *) die "используй: vpn grpc | vpn grpc on [ПОРТ] | vpn grpc off" ;;
  esac
}

cmd_status() {
  load
  if systemctl is-active --quiet xray; then grn "Xray работает"; stale_check; else red "Xray НЕ работает — см. journalctl -u xray -n 30"; fi
  local ver; ver=$(xray version 2>/dev/null | awk 'NR==1{print $2}')
  echo "Версия Xray:       ${ver:-?}"
  if [ -n "$ver" ] && [ "$(printf '%s\n%s\n' "$ver" 26.3.27 | sort -V | tail -1)" != "26.3.27" ]; then
    red "  Версия новее 26.3.27. Начиная с 26.9 Xray не пускает клиентов Clash Verge / FlClash (mihomo)."
    red "  Вернуть проверенную версию: bash -c \"\$(curl -fsSL https://github.com/XTLS/Xray-install/raw/main/install-release.sh)\" @ install --version v26.3.27"
  fi
  echo "IP сервера:        $IP"
  echo "Сайт-прикрытие:    $DEST"
  if bad_dest "$DEST"; then
    red "  ВНИМАНИЕ: $DEST заблокирован или замедляется в России — провайдер может рвать подключения."
    red "  Смени сайт-прикрытие: vpn dest auto"
  fi
  echo "Порты:             $PORTS"
  if command -v ss >/dev/null; then
    for p in $PORTS; do
      if ss -tln 2>/dev/null | grep -q ":$p "; then echo "  порт $p слушается"; else red "  порт $p НЕ слушается"; fi
    done
  fi
  if [ -n "$GPORT" ]; then
    echo "Запасной gRPC:     порт $GPORT"
    if command -v ss >/dev/null && ! ss -tln 2>/dev/null | grep -q ":$GPORT "; then red "  порт $GPORT НЕ слушается"; fi
  else
    echo "Запасной gRPC:     выключен (vpn grpc on — включить, если обычный VPN распознают)"
  fi
  echo "Мосты:             $(bridges | awk '{printf "%s%s:%s", (NR > 1 ? ", " : ""), $1, $2}' | grep . || echo нет)"
  echo "Версия «Свой VPN»: $VPN_VERSION"
  cmd_list
}

cmd_help() {
cat <<'EOF'
vpn — ключи для твоего VLESS-сервера

  vpn status            всё ли работает, IP, порты, список ключей
  vpn list              какие ключи выпущены
  vpn add ИМЯ           выпустить ключ для нового устройства (покажет ссылку и QR)
  vpn link ИМЯ          ещё раз показать ссылки и QR готового ключа
  vpn qr ИМЯ 8443       QR запасной ссылки (порт 8443)
  vpn yaml ИМЯ          профиль для Clash Verge (российские сайты напрямую)
  vpn yaml ИМЯ --all    профиль для Clash Verge (весь трафик через США)
  vpn del ИМЯ           отозвать ключ (например, потерян телефон)
  vpn log ИМЯ           подключалось ли устройство с этим ключом (последние записи)
  vpn dest              какой сайт-прикрытие сейчас и какие подходят
  vpn dest auto         сменить сайт-прикрытие на подходящий (потом обнови ссылки на всех устройствах)
  vpn dns               проверить DNS на сервере;  vpn dns on — сервер сам отвечает на DNS телефонов

Мост через российский сервер (сам мост настраивает установщик в режиме «мост»):
  vpn bridge list       какие мосты есть и отвечают ли они
  vpn bridge add IP     добавить мост: узел «через мост» появится в vpn yaml и vpn link
  vpn bridge test IP    сквозная проверка: этот сервер → мост → этот сервер → интернет
  vpn bridge del IP     убрать мост (потом сделай профили заново)
  vpn qr ИМЯ IP_МОСТА   QR ссылки через мост

Запасной транспорт gRPC — только если обычный VPN перестал работать и напрямую, и через мост:
  vpn grpc              включён ли и работает ли
  vpn grpc on           включить (порт 8443), потом новые профили: установщик, vpn yaml / vpn link
  vpn grpc off          выключить
  vpn qr ИМЯ grpc       QR ссылки gRPC (через мост: vpn qr ИМЯ grpc IP_МОСТА)

  vpn version           версия «Свой VPN» на этом сервере

Имена — латиницей: phone, phone-mama, laptop, ipad…
Ключ «clash» — это компьютер, который настроил скрипт из видео.
EOF
}

case "${1:-help}" in
  status) cmd_status ;;
  list|ls) cmd_list ;;
  add) cmd_add "${2:-}" ;;
  link|show|qr) cmd_link "${2:-}" "${3:-}" "${4:-}" ;;
  yaml|clash) cmd_yaml "${2:-}" "${3:-}" ;;
  del|rm|delete) cmd_del "${2:-}" ;;
  log) cmd_log "${2:-}" ;;
  dest) cmd_dest "${2:-}" ;;
  dns) cmd_dns "${2:-}" ;;
  bridge|bridges) cmd_bridge "${2:-}" "${3:-}" "${4:-}" ;;
  grpc) cmd_grpc "${2:-}" "${3:-}" ;;
  version|--version|-v) echo "$VPN_VERSION" ;;
  *) cmd_help ;;
esac
